# Get details of a specific session
@app.get("/api/face-sessions/{session_id}")
async def get_face_session(session_id: str):
    """Get a specific face processing session"""
    session = face_cache.get_session(session_id)
    if not session:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Session not found: {session_id}"
        )
    
    return {
        "message": "Session retrieved",
        "status": "success",
        "session": session
    }

# Delete a session
@app.delete("/api/face-sessions/{session_id}")
async def delete_face_session(session_id: str):
    """Delete a face processing session"""
    success = face_cache.delete_session(session_id)
    if not success:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Session not found or could not be deleted: {session_id}"
        )
    
    return {
        "message": "Session deleted",
        "status": "success"
    }

# Complete a session
@app.post("/api/face-sessions/{session_id}/complete")
async def complete_face_session(session_id: str):
    """Mark a session as completed"""
    success = face_cache.complete_session(session_id)
    if not success:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Session not found: {session_id}"
        )
    
    return {
        "message": "Session marked as completed",
        "status": "success"
    }

# Video processing API for face detection
@app.post("/api/process-video")
async def process_video(video: UploadFile = File(...),
                        sample_rate: int = Form(10),
                        session_id: Optional[str] = Form(None)):
    """
    Process a video file and extract faces using YOLO face detection.
    
    Args:
        video: The video file to process
        sample_rate: Process every N frames (default: 10)
        session_id: Optional session ID for continuing an existing session
    
    Returns:
        List of detected faces with metadata
    """
    # Create a new session if none provided
    if not session_id:
        session_id = face_cache.create_session()
        print(f"Created new face processing session: {session_id}")
    else:
        # Verify session exists
        session = face_cache.get_session(session_id)
        if not session:
            session_id = face_cache.create_session()
            print(f"Provided session not found, created new session: {session_id}")
    
    detected_faces = []
    error_occurred = False
    error_message = ""
    
    try:
        # Create a temporary file
        suffix = os.path.splitext(video.filename)[1]
        with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as temp_file:
            # Write the uploaded video to the temporary file
            shutil.copyfileobj(video.file, temp_file)
            temp_path = temp_file.name
        
        print(f"Processing video in session {session_id}")
        
        # Process the video
        try:
            detected_faces = face_detector.process_video(temp_path, sample_rate=sample_rate)
            print(f"Detected {len(detected_faces)} faces in video")
            
            # Add faces to the cache
            for face in detected_faces:
                # Extract the actual file path from the imageUrl
                face_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), face['imageUrl'].lstrip('/'))
                
                # Add to the cache
                face_cache.add_face(session_id, face_path, {
                    "timestamp": face['timestamp'],
                    "confidence": face.get('confidence', 1.0),
                    "frameNumber": face.get('frameNumber', 0)
                })
                
        except Exception as e:
            print(f"Error during face detection: {str(e)}")
            error_occurred = True
            error_message = str(e)
        
        # Clean up
        try:
            os.unlink(temp_path)
        except:
            pass
        
        # Get updated session data
        session = face_cache.get_session(session_id)
        cached_faces = []
        
        if session and 'faces' in session:
            cached_faces = [{
                'id': face['id'],
                'imageUrl': face['imageUrl'],
                'timestamp': face['metadata'].get('timestamp', '00:00:00'),
                'assigned': face['assigned'],
                'assignedTo': face.get('assignedTo', None),
                'confidence': face['metadata'].get('confidence', 1.0)
            } for face in session['faces']]
        
        # Return face details
        return {
            "message": f"Processed video in session {session_id}" + 
                      (f" with error: {error_message}" if error_occurred else f" and found {len(detected_faces)} faces"),
            "status": "partial_success" if error_occurred else "success",
            "error": error_message if error_occurred else None,
            "session_id": session_id,
            "faces": cached_faces
        }
    
    except Exception as e:
        print(f"Error processing video: {str(e)}")
        # Try to return any faces that were detected before the error
        session = face_cache.get_session(session_id)
        cached_faces = []
        
        if session and 'faces' in session:
            cached_faces = [{
                'id': face['id'],
                'imageUrl': face['imageUrl'],
                'timestamp': face['metadata'].get('timestamp', '00:00:00'),
                'assigned': face['assigned'],
                'assignedTo': face.get('assignedTo', None),
                'confidence': face['metadata'].get('confidence', 1.0)
            } for face in session['faces']]
            
        if cached_faces:
            return {
                "message": f"Partial processing of video due to error: {str(e)}",
                "status": "partial_success",
                "error": str(e),
                "session_id": session_id,
                "faces": cached_faces
            }
        else:
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=f"Error processing video: {str(e)}"
            )

# Assign detected face to an employee
@app.post("/api/assign-face")
async def assign_face(face_id: str = Form(...),
                     employee_id: str = Form(...),
                     session_id: str = Form(...),
                     employee_name: str = Form(None),
                     db: Session = Depends(get_db)):
    """
    Assign a detected face to an employee.
    This would typically update a database record.
    """
    try:
        # Verify session exists
        session = face_cache.get_session(session_id)
        if not session:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Session not found: {session_id}"
            )
            
        # If employee name not provided, try to get it from the database
        if not employee_name:
            # In a real app, you would query the employee table
            # For now, we'll use a mock name
            employee_name = f"Employee {employee_id}"
            
        # Assign the face in the cache
        success = face_cache.assign_face(session_id, face_id, employee_id, employee_name)
        
        if not success:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Face not found in session: {face_id}"
            )
        
        return {
            "message": f"Successfully assigned face {face_id} to employee {employee_id}",
            "status": "success"
        }
    except HTTPException:
        raise
    except Exception as e:
        print(f"Error assigning face: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Error assigning face: {str(e)}"
        )

